# Opt-in: everything is ignored unless listed below. Add a line when the
# repository gains a new kind of file.
*
!*/
# worktrees Claude Code makes for subagents: copies of this repository, each
# with its own build output; never part of it
/.claude/worktrees/

!/.gitignore
!/.coderabbit.yaml
!/Cargo.toml
!/Cargo.lock
!/LICENSE
!/README.md
!/install.sh
!/flake.nix
!/flake.lock
!/nix/*.nix
!/docs/*.md
!/.github/workflows/*.yml
!/site/*.html
!/site/*.svg

!/crates/*/Cargo.toml
!/crates/*/src/**/*.rs
!/crates/*/examples/*.rs
!/crates/*/tests/**/*.rs
# rule fixtures and the stub sources they compile against
!/crates/grounds-rules/tests/**/*.java

# regression corpus: pinned projects, planted bugs, and the scripts driving it
!/scripts/*.sh
!/scripts/*.py
!/scripts/*.baseline.json
!/corpus/projects.tsv
# smoke corpus: pinned projects grounds was not tuned on (scripts/smoke.py)
!/corpus/smoke.tsv
!/corpus/classpath-skip.tsv
!/corpus/replay-known.txt
# projects the rules were not tuned on, and what was measured on them
!/corpus/holdout.tsv
# published libraries whose class files judge grounds (scripts/bytecode_oracle.py)
!/corpus/oracle.tsv
!/docs/holdout/*
!/docs/smoke/*
!/corpus/planted/*.patch
!/corpus/planted/*.expected
!/corpus/ci/*.txt
!/corpus/ci-classpath/*.txt

# never descend into build output
/target/
/result
.grounds/
